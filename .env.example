FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=16400
# Optional: any OpenAI-compatible endpoint for the agent loop. Tool mode works without it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# The same three settings are also read from VISION_ENDPOINT / VISION_API_KEY / VISION_MODEL
# (and VISION_PROVIDER, VISION_API_VERSION). For an Azure OpenAI resource, `model` is the deployment name.
LLM_PROVIDER=
LLM_API_VERSION=
